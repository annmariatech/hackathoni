{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HyacinthPatch",
  "type": "object",
  "required": [
    "patch_id",
    "name",
    "area_sqm",
    "biomass_est_kg",
    "choke_score",
    "growth_trend",
    "geometry",
    "is_simulated"
  ],
  "properties": {
    "patch_id": { "type": "string" },
    "name": { "type": "string" },
    "area_sqm": { "type": "number", "minimum": 0 },
    "biomass_est_kg": { "type": "number", "minimum": 0 },
    "choke_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "growth_trend": { "type": "string", "enum": ["EXPANDING", "STABLE", "RECEDING"] },
    "geometry": {
      "type": "object",
      "required": ["type", "coordinates"],
      "properties": {
        "type": { "type": "string", "enum": ["Polygon", "MultiPolygon"] },
        "coordinates": { "type": "array" }
      }
    },
    "nearest_jetty": { "type": "string" },
    "is_simulated": { "type": "boolean" },
    "detected_at": { "type": "string", "format": "date-time" }
  }
}
