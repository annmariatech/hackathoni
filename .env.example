# Environment variables for Payal-to-Pay (പായൽ)
# Copy this file to .env and insert your real keys.
# NEVER commit .env to version control!

# Sarvam AI API Credentials
# Used for Saaras STT, Bulbul v3 TTS, and sarvam-30b/105b tool calling
SARVAM_API_KEY=your_sarvam_api_key_here

# Backend Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./payal.db

# Open-Meteo Configuration
OPEN_METEO_LATITUDE=9.4981
OPEN_METEO_LONGITUDE=76.3388

# Geo Engine Configuration
AOI_BBOX=76.33,9.47,76.43,9.56
USE_OFFLINE_RADAR_FIXTURE=true
